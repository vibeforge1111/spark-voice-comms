# Copy values into your local Builder environment or Spark secret layer.
# Do not commit a real .env file.

# Speech-to-text
OPENAI_API_KEY=<your-openai-api-key>
VOICE_TRANSCRIBE_PROVIDER=openai
VOICE_TRANSCRIBE_SECRET_ENV_REF=OPENAI_API_KEY
VOICE_TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# Text-to-speech
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
VOICE_TTS_ELEVENLABS_VOICE_ID=<your-elevenlabs-voice-id>
VOICE_TTS_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional local/free TTS tuning when using tts.provider_id=pyttsx3
VOICE_TTS_LOCAL_VOICE_NAME=<optional-local-voice-name>
VOICE_TTS_LOCAL_RATE=175
VOICE_TTS_LOCAL_VOLUME=0.9
