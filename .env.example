# Spark Voice Comms environment template.
# Copy needed values into your local Builder env file or Spark secret layer.
# Never commit a real .env file, provider key, voice id, or private local path.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Implemented TTS providers today: elevenlabs, openai-realtime, kokoro, pyttsx3.
# Planned TTS provider slots: minimax, zai.
# Codex CLI is useful as an agent/mission runner, but it is not a native STT/TTS
# provider for this chip, so do not set VOICE_TTS_PROVIDER=codex.
VOICE_TTS_PROVIDER=

# ---------------------------------------------------------------------------
# Speech-to-text: OpenAI-compatible hosted transcription
# ---------------------------------------------------------------------------
# Spark-managed installs bind voice.openai.api_key to VOICE_OPENAI_API_KEY.
# OPENAI_API_KEY remains supported for standalone/backward-compatible use.
VOICE_OPENAI_API_KEY=
VOICE_TRANSCRIBE_PROVIDER=openai
VOICE_TRANSCRIBE_SECRET_ENV_REF=VOICE_OPENAI_API_KEY
VOICE_TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Text-to-speech: ElevenLabs hosted TTS
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
VOICE_TTS_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
VOICE_TTS_ELEVENLABS_VOICE_ID=
VOICE_TTS_ELEVENLABS_VOICE_NAME=
VOICE_TTS_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---------------------------------------------------------------------------
# Text-to-speech: OpenAI GPT Realtime 2 hosted voice
# ---------------------------------------------------------------------------
# Requires: python -m pip install -e ".[openai-realtime]"
VOICE_TTS_OPENAI_REALTIME_SECRET_ENV_REF=VOICE_OPENAI_API_KEY
VOICE_TTS_OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime
VOICE_TTS_OPENAI_REALTIME_MODEL_ID=gpt-realtime-2
VOICE_TTS_OPENAI_REALTIME_VOICE=coral
VOICE_TTS_OPENAI_REALTIME_REASONING_EFFORT=low
VOICE_TTS_OPENAI_REALTIME_INSTRUCTIONS=Use a warm, calm Spark voice. Preserve the exact wording.
VOICE_TTS_OPENAI_REALTIME_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Text-to-speech: Kokoro local neural TTS
# ---------------------------------------------------------------------------
# Requires: python -m pip install -e ".[local-kokoro]"
# Keep absolute model paths local. Do not commit private filesystem paths.
VOICE_TTS_KOKORO_MODEL_PATH=
VOICE_TTS_KOKORO_VOICES_PATH=
VOICE_TTS_KOKORO_VOICE=af_sarah
VOICE_TTS_KOKORO_SPEED=1.0
VOICE_TTS_KOKORO_LANG=en-us

# ---------------------------------------------------------------------------
# Text-to-speech: pyttsx3 local system TTS
# ---------------------------------------------------------------------------
# Requires: python -m pip install -e ".[local-tts]"
VOICE_TTS_LOCAL_VOICE_NAME=
VOICE_TTS_LOCAL_RATE=175
VOICE_TTS_LOCAL_VOLUME=0.9

# ---------------------------------------------------------------------------
# Planned provider slot: MiniMax Speech
# ---------------------------------------------------------------------------
# Do not mark this ready until the MiniMax adapter and smoke test land.
MINIMAX_API_KEY=
VOICE_TTS_MINIMAX_BASE_URL=
VOICE_TTS_MINIMAX_GROUP_ID=
VOICE_TTS_MINIMAX_MODEL=speech-2.8-hd
VOICE_TTS_MINIMAX_VOICE_ID=

# ---------------------------------------------------------------------------
# Planned provider slot: Z.ai / GLM voice
# ---------------------------------------------------------------------------
# Z.ai is the provider; GLM is the model family. Do not mark this ready until
# the Z.ai voice adapter and smoke test land.
ZAI_API_KEY=
VOICE_TTS_ZAI_BASE_URL=
VOICE_TTS_ZAI_MODEL=glm-tts
VOICE_TTS_ZAI_VOICE=
