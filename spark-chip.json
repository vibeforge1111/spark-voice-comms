{
  "schema_version": "spark-chip.v1",
  "io_protocol": "spark-hook-io.v1",
  "chip_name": "spark-voice-comms",
  "domain": "voice-communications",
  "version": "0.1.1",
  "description": "Modular voice communications hooks for Spark Intelligence Builder.",
  "capabilities": ["voice.status", "voice.plan", "voice.onboard", "voice.install", "voice.transcribe", "voice.speak"],
  "task_keywords": [
    "voice",
    "reply in voice",
    "voice reply",
    "transcribe",
    "voice note",
    "set up voice",
    "install voice",
    "voice onboard",
    "voice install",
    "voice status",
    "kokoro",
    "tts",
    "stt",
    "speak this",
    "local tts",
    "paid voice"
  ],
  "task_topics": [
    "voice",
    "audio_io",
    "speech",
    "tts",
    "stt",
    "transcription",
    "voice_setup"
  ],
  "commands": {
    "voice.status": ["python", "-m", "voice_comms_chip.spark_hook", "voice.status"],
    "voice.plan": ["python", "-m", "voice_comms_chip.spark_hook", "voice.plan"],
    "voice.onboard": ["python", "-m", "voice_comms_chip.spark_hook", "voice.onboard"],
    "voice.install": ["python", "-m", "voice_comms_chip.spark_hook", "voice.install"],
    "voice.transcribe": ["python", "-m", "voice_comms_chip.spark_hook", "voice.transcribe"],
    "voice.speak": ["python", "-m", "voice_comms_chip.spark_hook", "voice.speak"]
  },
  "onboarding": {
    "role": "Speech I/O runtime for transcribing inbound audio and synthesizing spoken replies for Spark.",
    "surfaces": [
      "telegram",
      "cli",
      "researcher_bridge"
    ],
    "permissions": [
      "audio_io",
      "stt_provider",
      "tts_provider"
    ],
    "harnesses": [
      "voice.io"
    ],
    "health_checks": [
      "voice.status",
      "voice.onboard",
      "voice.install",
      "voice.plan"
    ],
    "example_intents": [
      "Reply in voice.",
      "Transcribe this voice note.",
      "Help me set up voice.",
      "Install Kokoro voice locally.",
      "Can I use free local TTS?",
      "Set up paid voice."
    ],
    "limitations": [
      "Installing this chip does not activate voice by itself; the host Spark runtime must approve and route voice.",
      "Provider keys and voice ids must come from local config or hook payloads, not the public repo.",
      "Quality depends on STT/TTS provider health and channel delivery behavior.",
      "Voice delivery still inherits Telegram and provider-specific media constraints."
    ]
  }
}
